{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bayaw-jobs",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "routes": [{ "pattern": "bayawjobs.riomar.dev", "custom_domain": true }],
  // The API only allows CORS from the custom domain, so the workers.dev URL would be broken.
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "bayaw-jobs"
    }
  ],
  "observability": {
    "enabled": true
  }
}
