# Copy to .env, then: npm start  (or: npm run once)
BAYAWSEC_API_URL=http://localhost:8787/api
# Same value as SCANNER_AGENT_TOKEN on the server (32+ chars, e.g. `openssl rand -hex 32`).
SCANNER_AGENT_TOKEN=
POLL_INTERVAL_MS=15000
NMAP_BIN=nmap
DOCKER_BIN=docker
ZAP_DOCKER_IMAGE=ghcr.io/zaproxy/zaproxy:stable
