# Copy to .dev.vars for `npm run dev`. Values here override "vars" in wrangler.jsonc.
# In production, set secrets with: npx wrangler secret put <NAME>

# Local dev: non-secure cookies on http://localhost.
NODE_ENV=development

# ── Auth (required) ──────────────────────────────────────────────────────────
JWT_ACCESS_TOKEN_SECRET=change-me
JWT_REFRESH_TOKEN_SECRET=change-me
JWT_VERIFICATION_SECRET=change-me

# The API allows exactly one origin; set it to your local client.
CORS_ORIGIN=http://localhost:3000

# ── BayawSec ─────────────────────────────────────────────────────────────────
BAYAWSEC_ENABLED=true

# AI provider: "openai" (default, better quality) or "ollama" (local dev fallback only).
AI_PROVIDER=openai
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4.1-mini
# Only used when AI_PROVIDER=ollama. A deployed Worker cannot reach localhost.
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# AI calls (interpret + remediate) allowed per assessor per day.
AI_DAILY_LIMIT=20

# Hosts BayawSec may assess. Add localhost while testing against `wrangler dev`.
ASSESSMENT_ALLOWED_HOSTS=bayawjobs.riomar.dev,bayawjobs-api.riomar.dev,localhost,127.0.0.1

# Optional scanner agent (see ../scanner-agent/README.md). Off unless exactly "true".
SCANNER_AGENT_ENABLED=false
# Long random string shared with the agent, e.g. `openssl rand -hex 32`.
SCANNER_AGENT_TOKEN=
