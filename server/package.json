{
  "name": "bayaw-jobs-api",
  "version": "1.0.0",
  "description": "Bayaw Jobs API on Cloudflare Workers",
  "scripts": {
    "dev": "wrangler dev",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "format": "prettier --write src/**/*.ts",
    "format:check": "prettier --check .",
    "format:check:ci": "./node_modules/.bin/prettier --check .",
    "type-check": "tsc --noEmit",
    "deploy": "wrangler deploy",
    "cf-typegen": "wrangler types",
    "db:generate": "prisma generate",
    "db:migrate:local": "wrangler d1 migrations apply bayaw-jobs-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply bayaw-jobs-db --remote",
    "db:seed:local": "node scripts/seed-local.mjs",
    "db:seed:remote": "npm run db:seed:local && wrangler d1 export bayaw-jobs-db --local --no-schema --output .wrangler/seed.sql && wrangler d1 execute bayaw-jobs-db --remote --file .wrangler/seed.sql --yes"
  },
  "keywords": [
    "express",
    "jobs",
    "api",
    "cloudflare-workers"
  ],
  "author": "riomar0001",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@prisma/adapter-d1": "^7.4.2",
    "@prisma/client": "^7.3.0",
    "@scalar/express-api-reference": "^0.8.39",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "helmet": "^8.1.0",
    "ipaddr.js": "^2.3.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.0.2",
    "typescript-eslint": "^8.56.1",
    "uuid": "^13.0.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@trivago/prettier-plugin-sort-imports": "^5.2.2",
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/helmet": "^0.0.48",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.0.0",
    "@types/node": "^25.1.0",
    "@types/supertest": "^6.0.3",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^8.56.0",
    "@typescript-eslint/parser": "^8.56.0",
    "cross-env": "^10.1.0",
    "eslint": "^10.0.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "pettier": "^1.1.0",
    "prisma": "^7.4.2",
    "supertest": "^7.2.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "wrangler": "^4.160.1"
  }
}
