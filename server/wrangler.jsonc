{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bayaw-jobs-api",
  "main": "src/worker.ts",
  "compatibility_date": "2026-11-10",
  "compatibility_flags": ["nodejs_compat"],
  "rules": [{ "type": "Data", "globs": ["**/*.jpg"], "fallthrough": true }],
  "vars": {
    "NODE_ENV": "production",
    "DEMO_MODE": "true",
    "APP_NAME": "Bayaw Jobs",
    "APP_URL": "https://bayawjobs-api.riomar.dev",
    "FRONTEND_URL": "https://bayawjobs.riomar.dev",
    "CORS_ORIGIN": "https://bayawjobs.riomar.dev",

    // BayawSec (AI-assisted security assessment). Secrets go in `wrangler secret put`
    // or .dev.vars: OPENAI_API_KEY, SCANNER_AGENT_TOKEN.
    "BAYAWSEC_ENABLED": "true",
    "AI_PROVIDER": "openai",
    "OPENAI_MODEL": "gpt-4.1-mini",
    "AI_DAILY_LIMIT": "20",
    // Hard allowlist: no target, scope rule or upload can reach a host outside this list.
    "ASSESSMENT_ALLOWED_HOSTS": "bayawjobs.riomar.dev,bayawjobs-api.riomar.dev",
    // Optional local scanner agent (Nmap/ZAP). Off unless exactly "true".
    "SCANNER_AGENT_ENABLED": "false"
  },
  "routes": [{ "pattern": "bayawjobs-api.riomar.dev", "custom_domain": true }],
  "workers_dev": false,
  "preview_urls": false,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "bayaw-jobs-db",
      "database_id": "b5fbb062-acd9-47c3-aa91-ec2a8b15ebbe",
      "migrations_dir": "prisma/migrations-d1"
    }
  ],
  "ratelimits": [
    { "name": "GENERAL_RATE_LIMITER", "namespace_id": "1001", "simple": { "limit": 60, "period": 60 } },
    { "name": "AUTH_RATE_LIMITER", "namespace_id": "1002", "simple": { "limit": 10, "period": 60 } },
    { "name": "STRICT_RATE_LIMITER", "namespace_id": "1003", "simple": { "limit": 5, "period": 60 } }
  ],
  "r2_buckets": [{ "binding": "FILES", "bucket_name": "bayaw-jobs-files" }],
  "queues": {
    "producers": [
      { "binding": "EMAIL_QUEUE", "queue": "bayaw-jobs-email" },
      { "binding": "ASSESSMENT_QUEUE", "queue": "bayaw-jobs-assessment" }
    ],
    "consumers": [
      {
        "queue": "bayaw-jobs-email",
        "max_retries": 3,
        "dead_letter_queue": "bayaw-jobs-email-dlq"
      },
      { "queue": "bayaw-jobs-email-dlq" },
      {
        "queue": "bayaw-jobs-assessment",
        "max_batch_size": 1,
        "max_retries": 2,
        "dead_letter_queue": "bayaw-jobs-assessment-dlq"
      },
      { "queue": "bayaw-jobs-assessment-dlq" }
    ]
  },
  "triggers": {
    // 12:00 AM Asia/Manila (UTC+8); cron triggers run in UTC.
    "crons": ["0 16 * * *"]
  },
  "observability": {
    "enabled": true,
    "traces": { "enabled": true }
  }
}
